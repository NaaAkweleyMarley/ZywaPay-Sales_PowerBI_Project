	partition Calendar = calculated
		mode: import
		source = ```
				
				    ADDCOLUMNS(
				        CALENDARAUTO(),
				            "Year",YEAR([Date]),
				            "Month",FORMAT([Date],"mmm"),
				            "MonthNumber", MONTH([Date]),
				            "Weekday", FORMAT([Date], "ddd"),
				            "WeekNumber", WEEKDAY([Date]),
				            "Qtr", FORMAT([Date], "\QQ")
				            
				            )
				```

	annotation PBI_Id = 010df779a6b24480988e550249dfdf14

