table Transactions_Fact
	lineageTag: bfa1f8b1-cc0f-4c55-9ee0-794b2da8b877

	measure 'Total Transactions' = COUNTROWS(Transactions_Fact)
		formatString: 0
		lineageTag: aa279392-87be-4892-a327-e00a2b56121b

	measure 'Total Amount' = SUM(Transactions_Fact[AmountGHS])
		lineageTag: 943c4881-a0ff-4e31-8351-b06310edcff6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Success %' =
			
			DIVIDE(
			    CALCULATE(COUNTROWS(Transactions_Fact),
			              Transactions_Fact[TransactionStatus] = "Completed"),
			    COUNTROWS(Transactions_Fact),
			    0
			)
		lineageTag: 20f40315-6eb8-48dd-a139-54edd6ca5a66

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Amount' = AVERAGE(Transactions_Fact[AmountGHS])
		lineageTag: dcb686b1-08db-4bbc-bdbd-265d9742bf86

		annotation PBI_FormatHint = {"isGeneralNumber":true}

